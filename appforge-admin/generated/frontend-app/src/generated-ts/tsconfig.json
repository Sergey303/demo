{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "runtime/**/*.ts",
    "shared/**/*.ts",
    "shared/**/*.json",
    "meta/**/*.ts",
    "operations/**/*.ts",
    "operations/**/*.json",
    "campaigns/types/**/*.ts",
    "campaignstatuses/types/**/*.ts",
    "leads/types/**/*.ts",
    "leadstatuses/types/**/*.ts",
    "permissions/types/**/*.ts",
    "rolepermissions/types/**/*.ts",
    "roles/types/**/*.ts",
    "subscribers/types/**/*.ts",
    "subscriberstatuses/types/**/*.ts",
    "campaigns/components/**/*.tsx",
    "campaignstatuses/components/**/*.tsx",
    "leads/components/**/*.tsx",
    "leadstatuses/components/**/*.tsx",
    "permissions/components/**/*.tsx",
    "rolepermissions/components/**/*.tsx",
    "roles/components/**/*.tsx",
    "subscribers/components/**/*.tsx",
    "subscriberstatuses/components/**/*.tsx",
    "campaigns/pages/**/*.tsx",
    "campaignstatuses/pages/**/*.tsx",
    "leads/pages/**/*.tsx",
    "leadstatuses/pages/**/*.tsx",
    "permissions/pages/**/*.tsx",
    "rolepermissions/pages/**/*.tsx",
    "roles/pages/**/*.tsx",
    "subscribers/pages/**/*.tsx",
    "subscriberstatuses/pages/**/*.tsx",
    "campaigns/realtime/**/*.ts",
    "campaignstatuses/realtime/**/*.ts",
    "leads/realtime/**/*.ts",
    "leadstatuses/realtime/**/*.ts",
    "permissions/realtime/**/*.ts",
    "rolepermissions/realtime/**/*.ts",
    "roles/realtime/**/*.ts",
    "subscribers/realtime/**/*.ts",
    "subscriberstatuses/realtime/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx"
  ]
}
