# Copy to .env.production and set real production values outside git.
APPFORGE_PUBLIC_ORIGIN=https://app.example.com
APPFORGE_HTTP_PORT=8080

# Filled by the production package generator from appforge-generation-manifest.json.
APPFORGE_GENERATED_PROJECT=backend/BusinessOperationsAdmin.Persistence.csproj
APPFORGE_ASSEMBLY=BusinessOperationsAdmin.Persistence.dll
APPFORGE_FRONTEND_ROOT=frontend-app

# PostgreSQL P0 default for generated production runtime.
# Sentinel values are not real secrets; replace them in untracked .env.production before customer deployment.
APPFORGE_POSTGRES_DB=business_operations_admin
APPFORGE_POSTGRES_USER=appforge
APPFORGE_POSTGRES_PASSWORD=__APPFORGE_SET_POSTGRES_PASSWORD__

# Initial production admin seed credentials.
# Replace both sentinels before running the api-seed profile.
APPFORGE_ADMIN_EMAIL=__APPFORGE_SET_ADMIN_EMAIL__
APPFORGE_ADMIN_PASSWORD=__APPFORGE_SET_ADMIN_PASSWORD__

# Reverse proxy trust boundary for Docker bridge networks. Narrow this in real hosting if possible.
APPFORGE_FORWARDED_KNOWN_NETWORK=172.16.0.0/12

APPFORGE_RATE_LIMIT_PER_MINUTE=120
APPFORGE_RATE_LIMIT_WINDOW_SECONDS=60
APPFORGE_RATE_LIMIT_QUEUE_LIMIT=0
APPFORGE_REQUEST_BODY_LIMIT_BYTES=10485760
APPFORGE_MULTIPART_LIMIT_BYTES=10485760

# Production email transport. SMTP passwords must be supplied from real secret storage, not committed here.
APPFORGE_EMAIL_MODE=Smtp
APPFORGE_EMAIL_SMTP_HOST=smtp.example.com
APPFORGE_EMAIL_SMTP_PORT=587
APPFORGE_EMAIL_SMTP_FROM=no-reply@example.com
APPFORGE_EMAIL_SMTP_USERNAME=
APPFORGE_EMAIL_SMTP_PASSWORD=__APPFORGE_SET_SMTP_PASSWORD__
APPFORGE_EMAIL_SMTP_ENABLE_SSL=true
