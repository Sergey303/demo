# Example only. One HTTPS listener with an explicit allow-host route and 421 fallback.
# Set the public hostname and certificate; do not use this as an open proxy.
# Caddy and BFF share a dedicated nonroot service UID. No access/debug logs.
{
    admin off
    auto_https disable_redirects
}

# Intentional catch-all listener: unknown Host values MUST reach the 421 fallback.
# TLS still uses the configured certificate, and only expected Host enters BFF.
https://:443 {
    tls /etc/ep12-edge/tls.crt /etc/ep12-edge/tls.key
    @expected_host host bff.example.test
    handle @expected_host {
        # Remove untrusted browser forwarding/rewriting metadata before proxying.
        request_header -Forwarded
        request_header -X-Original-*
        request_header -X-Forwarded-*
        reverse_proxy unix//run/ep12-bff/bff.sock {
            header_up Host bff.example.test
            header_up X-Forwarded-Host bff.example.test
            header_up X-Forwarded-Proto https
            # Caddy normally adds XFF; explicitly suppress it.
            header_up -X-Forwarded-For
            transport http {
                versions 1.1
            }
        }
    }
    handle {
        respond "Misdirected Request" 421
    }
}
